# satukenangan Environment Variables

# App URL Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Midtrans Payment Gateway Configuration
# Dapatkan Merchant ID & Keys dari Dashboard Midtrans: https://dashboard.midtrans.com (atau sandbox.midtrans.com)
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false

# Supabase production database
# Jalankan supabase/schema.sql di SQL Editor Supabase.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=event-photos